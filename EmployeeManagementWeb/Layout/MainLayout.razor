@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

@if (!ready)
{
    <div class="splash">Loading…</div>
}
else if (Auth.IsLoggedIn)
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">EMPLOYEE<br />MANAGEMENT</div>
            <nav>
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                @if (Auth.IsAdmin)
                {
                    <NavLink class="nav-item" href="employees">Employees</NavLink>
                }
                <NavLink class="nav-item" href="attendance">Attendance</NavLink>
                <NavLink class="nav-item" href="salary">@(Auth.IsAdmin ? "Salary Monitoring" : "My Salary")</NavLink>
                @if (Auth.IsAdmin)
                {
                    <NavLink class="nav-item" href="accounts">Account Management</NavLink>
                    <NavLink class="nav-item" href="requests">Service Requests</NavLink>
                }
                else
                {
                    <NavLink class="nav-item" href="self-service">Self-Service Portal</NavLink>
                }
            </nav>
            <button class="btn danger logout" @onclick="Logout">LOG OUT</button>
        </aside>

        <div class="main">
            <header class="topbar">
                <span class="who">@(Auth.Current?.Username) &nbsp;•&nbsp; @(Auth.Current?.Role)</span>
            </header>
            <main class="content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    bool ready;

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();
        ready = true;
        if (!Auth.IsLoggedIn) Nav.NavigateTo("login");
    }

    async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
