@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!ready)
{
    <div class="splash">Loading…</div>
}
else if (Auth.IsLoggedIn)
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand"><span class="brand-logo">🏢</span><span>EMPLOYEE<br />MANAGEMENT</span></div>
            <nav>
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All"><span class="ico">🏠</span>Dashboard</NavLink>
                @if (Auth.IsAdmin)
                {
                    <NavLink class="nav-item" href="employees"><span class="ico">👥</span>Employees</NavLink>
                }
                <NavLink class="nav-item" href="attendance"><span class="ico">🕒</span>Attendance</NavLink>
                <NavLink class="nav-item" href="salary"><span class="ico">💰</span>@(Auth.IsAdmin ? "Salary Monitoring" : "My Salary")</NavLink>
                @if (Auth.IsAdmin)
                {
                    <NavLink class="nav-item" href="accounts"><span class="ico">🔑</span>Account Management</NavLink>
                    <NavLink class="nav-item" href="requests"><span class="ico">📩</span>Service Requests</NavLink>
                }
                else
                {
                    <NavLink class="nav-item" href="self-service"><span class="ico">🙋</span>Self-Service Portal</NavLink>
                }
            </nav>
            <button class="btn danger logout" @onclick="Logout">🚪 LOG OUT</button>
        </aside>

        <div class="main">
            <header class="topbar">
                <button class="theme-btn" @onclick="ToggleTheme" title="Switch light / dark mode">@(dark ? "☀️" : "🌙")</button>
                <div class="user-chip">
                    <span class="avatar">@Initial</span>
                    <div><strong>@(Auth.Current?.Username)</strong><small>@(Auth.Current?.Role)</small></div>
                </div>
            </header>
            <main class="content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    bool ready;
    bool dark;

    string Initial => string.IsNullOrEmpty(Auth.Current?.Username) ? "?" : Auth.Current!.Username.Substring(0, 1).ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();
        dark = await JS.InvokeAsync<string>("ems.getTheme") == "dark";
        ready = true;
        if (!Auth.IsLoggedIn) Nav.NavigateTo("login");
    }

    async Task ToggleTheme()
    {
        dark = await JS.InvokeAsync<string>("ems.toggleTheme") == "dark";
    }

    async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
