@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject DataStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="login-wrap">
    <div class="login-card">
        <h1>EMPLOYEE MANAGEMENT SYSTEM</h1>
        <p class="muted center">Secure employee portal</p>

        <form @onsubmit="DoLogin" @onsubmit:preventDefault>
            <label>Username
                <input @bind="username" @bind:event="oninput" autocomplete="username" />
            </label>
            <label>Password
                <input type="password" @bind="password" @bind:event="oninput" autocomplete="current-password" />
            </label>
            <button type="submit" class="btn wide" disabled="@busy">LOGIN</button>
        </form>

        <Alert Message="@error" Ok="false" />

        <div class="demo">
            <strong>Demo accounts</strong><br />
            Owner: <code>owner</code> / <code>owner123</code><br />
            Employee: <code>employee</code> / <code>employee123</code><br />
            <button class="link" @onclick="ResetDemo">Reset all data to the demo defaults</button>
        </div>
    </div>
</div>

@code {
    string username = "";
    string password = "";
    string? error;
    bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();
        if (Auth.IsLoggedIn) Nav.NavigateTo("");
    }

    async Task DoLogin()
    {
        busy = true;
        error = null;
        if (await Auth.LoginAsync(username, password))
        {
            Nav.NavigateTo("");
            return;
        }
        error = "Invalid username or password.";
        password = "";
        busy = false;
    }

    async Task ResetDemo()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "This erases ALL employees, attendance, salary and accounts in this browser. Continue?"))
            return;
        await Store.ResetAsync();
        error = null;
    }
}
