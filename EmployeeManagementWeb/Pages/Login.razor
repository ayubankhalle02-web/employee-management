@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo">🏢</div>
        <h1>EMPLOYEE MANAGEMENT SYSTEM</h1>
        <p class="muted center">Welcome back! Please log in to continue 👋</p>

        <form @onsubmit="DoLogin" @onsubmit:preventDefault>
            <label>Username
                <input @bind="username" @bind:event="oninput" autocomplete="username" placeholder="Enter your username" />
            </label>
            <label>Password
                <input type="password" @bind="password" @bind:event="oninput" autocomplete="current-password" placeholder="Enter your password" />
            </label>
            <button type="submit" class="btn wide" disabled="@busy">LOGIN</button>
        </form>

        <Alert Message="@error" Ok="false" />
    </div>
</div>

@code {
    string username = "";
    string password = "";
    string? error;
    bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();
        if (Auth.IsLoggedIn) Nav.NavigateTo("");
    }

    async Task DoLogin()
    {
        busy = true;
        error = null;
        if (await Auth.LoginAsync(username, password))
        {
            Nav.NavigateTo("");
            return;
        }
        error = "Invalid username or password.";
        password = "";
        busy = false;
    }
}
