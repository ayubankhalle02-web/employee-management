@page "/requests"
@inject EmsService Svc
@inject AuthService Auth

<h1>Service Requests</h1>

@if (!Auth.IsAdmin)
{
    <p class="muted">You do not have access to this page.</p>
}
else
{
    <Alert Message="@msg" Ok="ok" />
    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>No.</th><th>Name</th><th>Type</th><th>Details</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Svc.ListRequests())
                {
                    <tr>
                        <td>@r.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@Svc.EmployeeNoOf(r.EmployeeId)</td>
                        <td>@Svc.EmployeeName(r.EmployeeId)</td>
                        <td>@r.RequestType</td>
                        <td class="wrap">@r.Details</td>
                        <td><span class="badge @r.Status.ToLowerInvariant()">@r.Status</span></td>
                        <td class="row-actions">
                            @if (r.Status != "Approved")
                            {
                                <button class="btn small" @onclick='() => Set(r, "Approved")'>Approve</button>
                            }
                            @if (r.Status != "Rejected")
                            {
                                <button class="btn small danger" @onclick='() => Set(r, "Rejected")'>Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    string? msg;
    bool ok;

    async Task Set(ServiceRequest r, string status)
    {
        var res = await Svc.SetRequestStatusAsync(r.Id, status);
        msg = res.Message;
        ok = res.Ok;
    }
}
