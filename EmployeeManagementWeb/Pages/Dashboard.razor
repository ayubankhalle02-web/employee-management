@page "/"
@inject EmsService Svc
@inject AuthService Auth

@if (stats == null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="banner">
        <div>
            <h1>Welcome back, @(Auth.Current?.Username)! 👋</h1>
            <p>
                @if (Auth.IsAdmin)
                {
                    <text>Use the menu to manage employees, attendance, payroll, accounts and service requests.</text>
                }
                else
                {
                    <text>Use the menu to punch in/out, view your salary records and send service requests.</text>
                }
            </p>
        </div>
        <div class="banner-emoji">📊</div>
    </div>

    <div class="cards">
        @if (Auth.IsAdmin)
        {
            <div class="stat blue"><div class="stat-ico">👥</div><div><span>ACTIVE EMPLOYEES</span><b>@stats.ActiveEmployees</b></div></div>
            <div class="stat green"><div class="stat-ico">🕒</div><div><span>TODAY'S ATTENDANCE</span><b>@stats.TodayAttendance</b></div></div>
            <div class="stat orange"><div class="stat-ico">📩</div><div><span>PENDING REQUESTS</span><b>@stats.PendingRequests</b></div></div>
        }
        else
        {
            <div class="stat green"><div class="stat-ico">🕒</div><div><span>MY ATTENDANCE TODAY</span><b class="small">@stats.MyStatus</b></div></div>
            <div class="stat orange"><div class="stat-ico">📩</div><div><span>MY PENDING REQUESTS</span><b>@stats.PendingRequests</b></div></div>
        }
    </div>
}

@code {
    DashboardStats? stats;

    protected override async Task OnInitializedAsync() => stats = await Svc.GetDashboardAsync();
}
