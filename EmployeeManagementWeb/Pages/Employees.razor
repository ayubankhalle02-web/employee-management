@page "/employees"
@inject EmsService Svc
@inject AuthService Auth
@inject IJSRuntime JS

<h1>Employee Management</h1>

@if (!Auth.IsAdmin)
{
    <p class="muted">You do not have access to this page.</p>
}
else
{
    <div class="card">
        <h2>@(form.Id == 0 ? "Add employee" : "Edit employee")</h2>
        <div class="grid3">
            <label>Employee No.<input @bind="form.EmployeeNo" @bind:event="oninput" /></label>
            <label>Full Name<input @bind="form.FullName" @bind:event="oninput" /></label>
            <label>Position<input @bind="form.Position" @bind:event="oninput" /></label>
            <label>Phone<input @bind="form.Phone" @bind:event="oninput" /></label>
            <label>Address<input @bind="form.Address" @bind:event="oninput" /></label>
            <label>Basic Salary (₱ / month)<input type="number" step="0.01" min="0" @bind="form.BasicSalary" /></label>
            <label>Date Hired<input type="date" @bind="form.DateHired" /></label>
        </div>
        <div class="actions">
            <button class="btn" @onclick="Save">@(form.Id == 0 ? "ADD EMPLOYEE" : "SAVE CHANGES")</button>
            @if (form.Id != 0)
            {
                <button class="btn secondary" @onclick="CancelEdit">CANCEL</button>
            }
        </div>
        <Alert Message="@msg" Ok="ok" />
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>No.</th><th>Name</th><th>Position</th><th>Phone</th><th>Address</th><th class="num">Basic Salary</th><th>Hired</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in Svc.ListEmployees())
                {
                    <tr class="@(e.Status == "Inactive" ? "dim" : "")">
                        <td>@e.EmployeeNo</td>
                        <td>@e.FullName</td>
                        <td>@e.Position</td>
                        <td>@e.Phone</td>
                        <td>@e.Address</td>
                        <td class="num">₱@e.BasicSalary.ToString("N2")</td>
                        <td>@e.DateHired</td>
                        <td>@e.Status</td>
                        <td class="row-actions">
                            <button class="btn small" @onclick="() => Edit(e)">Edit</button>
                            <button class="btn small secondary" @onclick="() => ToggleStatus(e)">@(e.Status == "Active" ? "Deactivate" : "Activate")</button>
                            @if (Auth.IsOwner)
                            {
                                <button class="btn small danger" @onclick="() => Delete(e)">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    Employee form = new();
    string? msg;
    bool ok;

    protected override async Task OnInitializedAsync() => await ResetForm();

    async Task ResetForm()
    {
        var now = await Svc.NowAsync();
        form = new Employee { DateHired = EmsService.DateKey(now), Status = "Active" };
    }

    async Task Save()
    {
        var r = await Svc.SaveEmployeeAsync(form);
        msg = r.Message;
        ok = r.Ok;
        if (r.Ok) await ResetForm();
    }

    void Edit(Employee e)
    {
        form = e.Clone();
        msg = null;
    }

    async Task CancelEdit()
    {
        msg = null;
        await ResetForm();
    }

    async Task ToggleStatus(Employee e)
    {
        var r = await Svc.SetEmployeeStatusAsync(e.Id, e.Status == "Active" ? "Inactive" : "Active");
        msg = r.Message;
        ok = r.Ok;
    }

    async Task Delete(Employee e)
    {
        var sure = await JS.InvokeAsync<bool>("confirm",
            $"Permanently delete {e.FullName}? This also deletes their attendance, salary records, requests and login account.");
        if (!sure) return;

        var r = await Svc.DeleteEmployeeAsync(e.Id);
        msg = r.Message;
        ok = r.Ok;
        if (r.Ok && form.Id == e.Id) await ResetForm();
    }
}
